{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "sgirq-web": {
      "projectType": "application", "root": "", "sourceRoot": "src", "prefix": "app",
      "architect": {
        "build": { "builder": "@angular/build:application", "options": {
          "outputPath": "dist/sgirq-web", "index": "src/index.html", "browser": "src/main.ts",
          "tsConfig": "tsconfig.app.json", "assets": [{"glob":"**/*", "input":"public"}],
          "styles": ["src/styles.css"]
        }},
        "serve": { "builder": "@angular/build:dev-server", "options": { "buildTarget": "sgirq-web:build" }}
      }
    }
  }, "cli": { "analytics": false }
}
